# Single Page App (React Router): cualquier ruta que no sea un archivo o carpeta
# real (p. ej. /tienda-virtual) se sirve con index.html para que React la resuelva.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
